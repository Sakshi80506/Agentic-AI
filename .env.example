# ==============================================================================
# AGENTIC AI MEETING & PRODUCTIVITY ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION (Descope - Stage 2)
# Free Tier: up to 7,500 Monthly Active Users & Unlimited Social/Google Logins
# Obtain from: https://app.descope.com -> Project Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DESCOPE_PROJECT_ID=your_descope_project_id_here
# Optional Management Key for server-side administrative tasks
DESCOPE_MANAGEMENT_KEY=your_descope_management_key_here

# ------------------------------------------------------------------------------
# 2. DATABASE (Neon Serverless PostgreSQL + Prisma ORM - Stage 2)
# Free Tier: 0.5 GiB storage, serverless autoscaling compute
# Obtain from: https://console.neon.tech -> Connection Details (pooled connection string)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. AI AGENT ORCHESTRATION (Mastra + Google Gemini Free Tier - Stage 3)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. GOOGLE CALENDAR & OAUTH 2.0 (Stage 5)
# Obtain from: https://console.cloud.google.com -> Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
